# ==============================================================================
# GRC Agent 환경 변수 템플릿 (.env.example)
# ==============================================================================
# [주의] 이 파일은 템플릿이며 실제 비밀키를 적지 않습니다.
# 사용 방법:
#   1. 이 파일을 복사하여 '.env' 파일을 생성합니다: cp .env.example .env
#   2. 새로 생성된 '.env' 파일 안에 실제 API 키를 입력합니다.
#   3. '.env' 파일은 .gitignore에 등록되어 있으므로 Git에 커밋되지 않습니다.
# ==============================================================================

# [1] 애플리케이션 기본 설정
APP_ENV=development
LOG_LEVEL=INFO

# [2] LLM AI 모델 제공자 API 키 (사용할 모델에 맞춰 입력)
# Gemini API Key (Google AI Studio에서 발급)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (필요시 사용)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (필요시 사용)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# [3] GRC 웹 콘솔 접근 인증 (python -m secgrc web)
# 인증 모드: auto(기본, 로컬호스트 접속 면제) | required(모든 접속 인증) | disabled(비권장)
GRC_WEB_AUTH=auto
# Basic Auth 계정. 비밀번호 미설정 시 서버 시작 시 임시 비밀번호가 자동 생성되어 콘솔에 출력됩니다.
GRC_WEB_USERNAME=admin
GRC_WEB_PASSWORD=
# API 클라이언트용 키 (Authorization: Bearer 또는 X-API-Key 헤더). 미설정 시 웹 비밀번호로 인증합니다.
GRC_API_KEY=
